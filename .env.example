# ============ 基础 ============
# 覆盖安装目录下的 .env；docker-compose 会注入同名单词
APP_ENV=dev

# ============ 数据层 ============
# 本地 docker-compose 默认；生产改真实地址
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/wechat_tools?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

# ============ 安全 ============
# BFF 会话令牌签名密钥，生产必须改（openssl rand -hex 32）
JWT_SECRET=dev-only-change-me-in-production
JWT_EXPIRE_DAYS=7
# 签名时间窗（秒），超宽/超窄都影响防重放
SIGN_WINDOW_SECONDS=300

# ============ 微信 ============
# 默认小程序（首个 AI 抠图小程序）；其余小程序配置在 apps 表，不在此处
WECHAT_APPID=wx0000000000000000
WECHAT_SECRET=your-wechat-secret

# ============ 积分规则（与产品约定一致） ============
REGISTER_GIFT_CREDITS=100
CUTOUT_COST_CREDITS=10
CHECKIN_CREDITS=10
AD_REWARD_CREDITS=20
AD_REWARD_DAILY_LIMIT=10

# ============ 抠图上游（UPSTREAM_MODE: tencent | oneapis | selfhosted） ============
# MVP：腾讯云人像分割（iai SegmentPortraitPic），0.01 元/次，月 1000 次免费
UPSTREAM_MODE=tencent
TENCENT_SECRET_ID=your-tencent-secret-id
TENCENT_SECRET_KEY=your-tencent-secret-key
TENCENT_REGION=ap-guangzhou

# 二期：oneapis 透传（自定义渠道）或自部署 BiRefNet
# UPSTREAM_MODE=oneapis
ONEAPIS_BASE_URL=https://api.oneapis.cn
ONEAPIS_API_KEY=your-oneapis-key
ONEAPIS_CUTOUT_PATH=/v1/images/segment

# ============ 支付（MVP 关闭，二期开启） ============
VPAY_ENABLED=false
VPAY_MCH_ID=
VPAY_API_V3_KEY=

# ============ 微信支付 JSAPI（安卓充值；iOS 走站外引导） ============
# 全部为空 = 充值关闭（recharge-order 返回 403）。填齐后 WXPAY_ENABLED=true 开启安卓 JSAPI。
WXPAY_ENABLED=false
WXPAY_MCH_ID=
WXPAY_APP_ID=wx13097c906c363f4d
# 商户 API 证书序列号（微信商户平台 -> API 证书）
WXPAY_SERIAL_NO=
# 商户 API 私钥：PEM 全文，.env 里用双引号包裹、换行以 \n 转义（加载时自动还原换行）
#   例：WXPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
# 也可放文件后此处留空、改用 WXPAY_PRIVATE_KEY_FILE 路径（生产推荐，避免密钥进 .env 明文）
WXPAY_PRIVATE_KEY=
WXPAY_PRIVATE_KEY_FILE=
# APIv3 密钥（32 字节，回调解密 AES-GCM key）：openssl rand -base64 32
WXPAY_API_V3_KEY=
# 微信平台证书公钥 PEM（可选；配置后严格验签回调，否则跳过验签）
WXPAY_PLATFORM_PUBLIC_KEY=
# 支付结果异步回调地址（公网 HTTPS，微信调，免 BFF 签名）：填部署后的真实地址
WXPAY_NOTIFY_URL=https://bff.oneapis.cn/api/credits/recharge-notify
# 扫码登录会话有效期（秒）
SCAN_EXPIRE_SECONDS=300
# 充值：元 -> 积分（与用户侧展示一致：1 元 = 10 积分）
RECHARGE_YUAN_TO_CREDITS=10
# iOS 引导充值页（站外 PC/H5，合规绕过苹果虚拟支付红线）
RECHARGE_WEB_URL=https://oneapis.cn/recharge

# ============ new-api 网关（影子账号 / 额度账本，P0） ============
# 网关根地址（newapi-bff.oneapis.cn，/api 由 new-api 本体接管）
NEWAPI_BASE_URL=https://newapi-bff.oneapis.cn
# 管理员凭证：优先 env 直供 PAT（完全不消耗会话配额，生产首选）；管理员 uid（new-api users.id）
NEWAPI_ADMIN_PAT=
NEWAPI_ADMIN_UID=0
# 兜底账密（PAT 401 自愈用；会消耗会话配额，换完自动归还）
NEWAPI_ADMIN_USERNAME=
NEWAPI_ADMIN_PASSWORD=
# 管理员 PAT 落盘缓存（0600；多实例 401 自愈靠重读此文件，避免乒乓轮换）
NEWAPI_ADMIN_CRED_FILE=./data/admin_cred.json
# 兜底轮换冷静期（秒）：多实例共用管理员时防乒乓烧穿会话/签发额度
ADMIN_LOGIN_COOLDOWN_SECONDS=300
# 用户 PAT 落库加密密钥（Fernet key，openssl rand -base64 32 | tr -d '\n'）；为空则注册不建影子账号
PAT_ENC_KEY=

# ============ 额度换算与发放（P1） ============
# 积分 -> quota：quota_value = amount * QUOTA_PER_CREDIT（QuotaPerUnit 待网关后台确认后校准）
QUOTA_PER_CREDIT=5000
# 管理台管理员手机号（逗号分隔）
ADMIN_PHONES=
# quota_grants 补偿最大重试次数（超过置 failed 人工介入）
GRANT_MAX_RETRIES=10
# 余额代理缓存秒数
BALANCE_CACHE_SECONDS=60

# 日终对账（P2）：pending 积压告警阈值 / 管理员池子最低余额（0=不查）
RECON_PENDING_ALERT=20
RECON_MIN_ADMIN_QUOTA=1000000000

# ============ Celery ============
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ============ 小程序自举注册（apps 表，启动自动 upsert，免手工 SQL） ============
# 部署只需填这三个，BFF 启动把具身之道写进 apps 表；已存在则更新（支持密钥轮换）。
#   sign_key 用 openssl rand -hex 32 生成，且与前端 miniprogram/utils/config.js 的
#   SIGN_KEY 完全一致（不一致前端签名被 BFF 全拒）。
#   secret = 微信公众平台该小程序的 AppSecret（bind-phone 服务端换手机号要用）。
BOOTSTRAP_APP_ID=wx13097c906c363f4d
BOOTSTRAP_APP_SECRET=
BOOTSTRAP_APP_SIGN_KEY=
BOOTSTRAP_APP_NAME=具身之道
# 多小程序（未来批量模板，可选）：JSON 数组，每项 {app_id,secret,sign_key,name,status}
# BOOTSTRAP_APPS_JSON=[{"app_id":"wxOTHER","secret":"...","sign_key":"...","name":"其他小程序","status":1}]

# ============ 服务器直拉部署（docker-compose.server.yml 用） ============
# mysql 容器 root 密码（openssl rand -hex 16）；compose 注入 DATABASE_URL 覆盖上面默认。
# MYSQL_ROOT_PASSWORD=
# BFF 宿主机映射端口（只绑回环，Nginx 终止 TLS 后反代到此）
# WTB_PORT=8010
